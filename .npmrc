# pnpm configuration for this repo.
# https://pnpm.io/npmrc

# Install peer dependencies automatically so Octokit & friends just work.
auto-install-peers=true

# Don't fail noisily on optional peer mismatches; CI logs are clean enough.
strict-peer-dependencies=false

# Enforce the `engines` field in package.json (Node >= 18, pnpm >= 9).
engine-strict=true

# Refuse to run if someone tries to `npm install` / `yarn install` in this
# repo - keeps the lockfile authoritative.
package-manager-strict=true
