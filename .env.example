# Baserow Cloud (https://baserow.io)
BASEROW_API_TOKEN=
# Optional - override only when self-hosting Baserow
# BASEROW_API_BASE_URL=https://api.baserow.io

# Required for README/EXTENDED generation and link checking
BASEROW_PROVIDERS_TABLE_ID=
BASEROW_CATEGORIES_TABLE_ID=

# Optional, but recommended
BASEROW_README_BLOCKS_TABLE_ID=
BASEROW_GITHUB_ISSUES_TABLE_ID=

# README publishing gates. Rows with any other Status are hidden.
README_STATUSES=Active - Awesome List
EXTENDED_STATUSES=Active - Extended List

# GitHub - PAT with public_repo scope (for the issues sync)
GH_API_TOKEN=
GH_OWNER=AdamXweb
GH_REPO=awesome-aussie

# Legacy Airtable import only. Not needed for Baserow automations.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
